{
  "name": "@stocksharp/indicators",
  "version": "2.0.1",
  "description": "StockSharp JS Indicators — 163 technical-analysis indicators driven bar by bar, a machine-readable catalogue of their parameters, and a suite that checks them against the C# StockSharp platform. No DOM, no dependencies.",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "StockSharp Platform LLC",
    "url": "https://stocksharp.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StockSharp/JS-Indicators.git"
  },
  "homepage": "https://stocksharp.com",
  "bugs": {
    "url": "https://github.com/StockSharp/JS-Indicators/issues"
  },
  "keywords": [
    "stocksharp",
    "indicators",
    "technical-analysis",
    "technical-indicators",
    "trading",
    "moving-average",
    "rsi",
    "macd",
    "bollinger-bands",
    "ichimoku",
    "incremental",
    "streaming",
    "typescript",
    "algorithmic-trading"
  ],
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/ssindicators.js",
  "jsdelivr": "./dist/ssindicators.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./source": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/esm",
    "dist/types",
    "dist/ssindicators.js",
    "dist/ssindicators.js.map",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "prepare": "node build.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "api:check": "node tools/check-public-api.mjs",
    "api:update": "node tools/check-public-api.mjs --update",
    "parity:update": "node tools/parity-update.mjs",
    "test": "npm run typecheck && npm run api:check && node build-tests.mjs && node tools/parity-dump.mjs && node --test \"tests/_dist/**/*.test.cjs\"",
    "pack:check": "npm pack --dry-run",
    "release:check": "node tools/check-release-tag.mjs",
    "release:patch": "npm version patch -m \"chore: release v%s\"",
    "release:minor": "npm version minor -m \"chore: release v%s\"",
    "release:major": "npm version major -m \"chore: release v%s\""
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}
